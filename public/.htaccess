# Compression and caching for the static export on Apache / Hostinger.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Only content-hashed build assets may be cached indefinitely.
  <FilesMatch "^(?:[a-f0-9]{16}|turbopack-[a-f0-9]+).*\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(?:html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
